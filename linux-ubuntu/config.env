# Quantus mining — Ubuntu 24.04 rental
# Hardware: RTX 3070 Laptop 8GB + RTX 3060 Ti 8GB + Ryzen 9 9950X

PAYOUT_ADDRESS="PASTE_YOUR_QZK_ADDRESS_HERE"
WORKER_NAME="rental9950x"

# Miner requires IP:port (not a hostname)
POOL_IP="40.160.89.50"
POOL_PORT="9834"
POOL_API="https://mine.miningcrypto.online/qtc"

# GPUs: 2 = both cards. If miner aborts immediately, set GPU_DEVICES=0 (CPU-only)
# or GPU_DEVICES=1 and retry.
GPU_DEVICES=2
CPU_WORKERS=8

# USE_CUDA=1 needs a working CUDA toolkit in the container (often crashes on
# mixed laptop/desktop GPU rentals). Prefer 0 (Vulkan/wgpu) first.
USE_CUDA=0
