# Quantus mining — Ubuntu 24.04 rental
# Hardware: RTX 3070 Laptop 8GB + RTX 3060 Ti 8GB + Ryzen 9 9950X
#
# 1) Edit PAYOUT_ADDRESS below (your qz… address from the Quantus wallet)
# 2) bash setup-and-mine.sh

PAYOUT_ADDRESS="PASTE_YOUR_QZK_ADDRESS_HERE"
WORKER_NAME="rental9950x"

# Miner requires IP:port (not a hostname)
POOL_IP="40.160.89.50"
POOL_PORT="9834"
POOL_API="https://mine.miningcrypto.online/qtc"

# 2 CUDA GPUs; light CPU assist from the 9950X (set CPU_WORKERS=0 for GPU-only)
GPU_DEVICES=2
CPU_WORKERS=8
USE_CUDA=1
